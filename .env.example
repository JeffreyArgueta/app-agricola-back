# Environment — copiar a .env y llena con valores reales
# Ver src/config/environment.js para validar variables de entorno requeridas

NODE_ENV=development
PORT=3000

# CORS — lista de permitidos separados por coma
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Base de Datos — MySQL + Sequelize (mysql2)
DB_URI=mysql://cassa_user:changeme@localhost:3306/dbname
DB_DIALECT=mysql
DB_USER=cassa_user
DB_PASSWORD=changeme
DB_HOST=localhost
DB_PORT=3306
DB_NAME=dbname
